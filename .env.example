# ==============================================================================
# Campus Navigation System — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with deployment-specific credentials.
# NEVER commit .env containing actual secrets to version control.

# Application Environment (development, testing, production)
APP_ENV=development
FLASK_DEBUG=1
LOG_LEVEL=INFO

# Web Server Configuration
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration (PostgreSQL with PostGIS)
# For local development with PostGIS:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/campus_nav_dev
# Standalone local fallback for SQLite when testing without PostGIS:
# DATABASE_URL=sqlite:///campus_nav.db

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Rate Limiting (Flask-Limiter)
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://

# Optional External Routing Provider (Google Maps Routes API)
# Campus internal routing is 100% self-contained and does NOT require this key.
GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_PROJECT=

# Initial Admin Credentials for Seeding
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=CampusAdmin2026!
