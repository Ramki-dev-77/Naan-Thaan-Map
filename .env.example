# ==============================================================================
# Campus Navigation System — Environment Configuration Template
# ==============================================================================
# Optional local overrides. The application starts without a .env file.
# NEVER commit .env containing actual secrets to version control.

# Application Environment (development, testing, production)
APP_ENV=development
FLASK_DEBUG=1
LOG_LEVEL=INFO

# Web Server Configuration
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Rate Limiting (Flask-Limiter)
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://

# Optional External Routing Provider (Google Maps Routes API)
# Campus internal routing is 100% self-contained and does NOT require this key.
GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_PROJECT=

